package Aefos.License;

// NOTE: the $R *.res resource directive is intentionally omitted so a fresh
// command-line/group build never fails on a missing Aefos.License.res. Open the
// project in the IDE later to add version info if wanted.
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Aefos License - node-locked seat licensing + activation screen'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl;

contains
  Aefos.License.Token in '..\..\source\license\Aefos.License.Token.pas',
  Aefos.License.Client in '..\..\source\license\Aefos.License.Client.pas',
  Aefos.License.Gate in '..\..\source\license\Aefos.License.Gate.pas',
  Aefos.License.UI in '..\..\source\license\Aefos.License.UI.pas';

end.
