        <DCCReference Include="Aefos.Tools.dcp"/>
        <DCCReference Include="..\..\source\compat\Aefos.Compat.Json.pas"/>
        <DCCReference Include="..\..\source\compat\Aefos.Compat.Sha256.pas"/>
        <DCCReference Include="..\..\source\compat\Aefos.Compat.IO.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Server.pas"/>
