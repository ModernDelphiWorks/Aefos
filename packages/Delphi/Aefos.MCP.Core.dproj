        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.Build.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.FormsDFM.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.DPR.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.CodeInsight.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.ProjectGroup.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.Packages.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.IDE.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.Resources.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.GitFacade.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.UnifiedDiff.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.Git.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.Rename.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.AuditQuery.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.ChatInspector.Types.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Tools.ChatInspector.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.DFMParser.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.DPRParser.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.PasParser.pas"/>
        <DCCReference Include="..\..\source\mcp\Core\Aefos.MCP.Transport.NamedPipe.pas"/>
